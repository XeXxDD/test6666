local commandPath = basePath .. "spawn_command.txt"
local logPath = basePath .. "CustomSpawner.log"

local function Log(message)
    local file = io.open(logPath, "a")
    if file then
        file:write(os.date("[%Y-%m-%d %H:%M:%S] ")
            .. tostring(message) .. "\n")
        file:close()
    end
end

Log("========================================")
Log("CustomSpawner started")

local checkInterval = 500

local function DiagnoseNA01()
    Log("TEST4 REQUEST")

    ExecuteInGameThread(function()
        Log("TEST4 GAME THREAD ENTERED")

        local assetPath =
            "/Game/Art/Character/Monster/CH_M_NA_01/Blueprints/CH_M_NA_01_BluePrint"

        local okLoad, asset = pcall(function()
            return LoadAsset(assetPath)
        end)

        Log("TEST4 LOAD PCALL: " .. tostring(okLoad))

        if not okLoad then
            Log("TEST4 LOAD ERROR: " .. tostring(asset))
            return
        end

        Log("TEST4 ASSET NON-NIL: " .. tostring(asset ~= nil))
        Log("TEST4 CALLBACK FINISHED")
		
		
        local okGenerated, generatedClass = pcall(function()
            return asset.GeneratedClass
        end)

        Log("TEST5 GENERATED PCALL: " .. tostring(okGenerated))

        if not okGenerated then
            Log("TEST5 GENERATED ERROR: " .. tostring(generatedClass))
            return
        end

        Log("TEST5 GENERATED NON-NIL: " .. tostring(generatedClass ~= nil))

        if generatedClass ~= nil then
            Log("TEST5 GENERATED TYPE: " .. tostring(generatedClass:type()))
        end

        Log("TEST5 CALLBACK FINISHED")
		
			
    end)

    Log("TEST4 CALLBACK SCHEDULED")
end


local function CheckCommand()
    local file = io.open(commandPath, "r")

    if file then
        local command = file:read("*l")
        file:close()

        local removed, removeError = os.remove(commandPath)

        if command and command ~= "" then
            Log("COMMAND RECEIVED: " .. command)
            Log("COMMAND FILE REMOVED: " .. tostring(removed))

			if command == "DIAG_NA01" then
				DiagnoseNA01()
			else
				Log("NPC spawn not implemented yet: " .. command)
			end
        end
    end

    ExecuteWithDelay(checkInterval, CheckCommand)
end

if type(io) == "table"
    and type(io.open) == "function"
    and type(os) == "table"
    and type(os.remove) == "function"
    and type(os.date) == "function"
    and type(ExecuteWithDelay) == "function" then

    Log("Command receiver started")
    ExecuteWithDelay(checkInterval, CheckCommand)
else
    print("[CustomSpawner] ERROR: required Lua API unavailable")
end
